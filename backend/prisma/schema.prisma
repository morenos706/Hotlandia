// CONTRACTUS 360 — Modelo de datos (Fase 1: solo actor CONTRATISTA)
// Los enums de estado incluyen valores de revisión (SUBMITTED/APPROVED/...)
// pensados para la Fase 2 (supervisor), aunque hoy no hay flujo que los use,
// para no requerir una migración disruptiva más adelante.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// USUARIOS
// ---------------------------------------------------------------------------

enum UserRole {
  CONTRATISTA
  ADMIN // administración técnica de la plataforma (no es un rol funcional de negocio en esta fase)
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String
  fullName       String
  identification String? // cédula / NIT de la persona natural contratista
  phone          String?
  role           UserRole @default(CONTRATISTA)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contracts        Contract[]        @relation("ContractContractor")
  activities       Activity[]        @relation("ActivityResponsible")
  executionRecords ExecutionRecord[]
  evidences        Evidence[]
  documents        Document[]
  auditLogs        AuditLog[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// CONTRATOS
// ---------------------------------------------------------------------------

enum ContractStatus {
  EN_PREPARACION
  EN_EJECUCION
  SUSPENDIDO
  REINICIADO
  PROXIMO_A_VENCER
  TERMINADO
  LIQUIDADO
  CANCELADO
}

enum ContractType {
  PRESTACION_SERVICIOS
  OBRA
  SUMINISTRO
  CONSULTORIA
  INTERVENTORIA
  COMPRAVENTA
  ARRENDAMIENTO
  CONVENIO
  OTRO
}

model Contract {
  id             String       @id @default(uuid())
  contractNumber String       @unique
  vigencia       Int // año fiscal
  contractType   ContractType
  modality       String // modalidad de contratación (licitación, mínima cuantía, directa, etc.)
  purpose        String       @db.Text // objeto contractual

  contractorId        String
  contractor          User    @relation("ContractContractor", fields: [contractorId], references: [id])
  legalRepresentative String?

  dependency    String?
  project       String?
  fundingSource String?
  budgetLine    String?
  cdp           String?
  rp            String?
  secopId       String? // referencia informativa, no integración oficial con SECOP II
  secopUrl      String?

  initialValue Decimal @db.Decimal(18, 2)
  currentValue Decimal @db.Decimal(18, 2)

  startDate       DateTime
  endDate         DateTime
  originalEndDate DateTime // se conserva para calcular desviación de plazo aun con prórrogas
  termDays        Int

  status       ContractStatus @default(EN_PREPARACION)
  observations String?        @db.Text

  toleranceYellow Decimal @default(10) @db.Decimal(5, 2) // % de desviación para semáforo amarillo
  toleranceRed    Decimal @default(20) @db.Decimal(5, 2) // % de desviación para semáforo rojo

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  modifications    ContractModification[]
  obligations      Obligation[]
  evidences        Evidence[]
  documents        Document[]
  payments         Payment[]
  alerts           Alert[]
  indicatorResults IndicatorResult[]
  executionPeriods ExecutionPeriod[]

  @@index([contractorId])
  @@index([status])
  @@map("contracts")
}

enum ModificationType {
  ADICION
  REDUCCION
  PRORROGA
  SUSPENSION
  REINICIO
  OTROSI
  CESION
}

model ContractModification {
  id              String           @id @default(uuid())
  contractId      String
  contract        Contract         @relation(fields: [contractId], references: [id])
  type            ModificationType
  description     String           @db.Text
  valueDelta      Decimal?         @db.Decimal(18, 2) // positivo (adición) o negativo (reducción); null si no aplica
  daysDelta       Int? // días de prórroga o de suspensión
  previousValue   Decimal          @db.Decimal(18, 2)
  newValue        Decimal          @db.Decimal(18, 2)
  previousEndDate DateTime
  newEndDate      DateTime
  effectiveDate   DateTime
  documentId      String?
  createdAt       DateTime         @default(now())

  @@index([contractId])
  @@map("contract_modifications")
}

// ---------------------------------------------------------------------------
// OBLIGACIONES Y ACTIVIDADES
// ---------------------------------------------------------------------------

model Obligation {
  id               String    @id @default(uuid())
  contractId       String
  contract         Contract  @relation(fields: [contractId], references: [id])
  code             String
  description      String    @db.Text
  type             String? // técnica, administrativa, financiera, etc.
  weightPercentage Decimal   @default(0) @db.Decimal(5, 2)
  goal             String?
  indicator        String?
  unitOfMeasure    String?
  observations     String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  activities Activity[]

  @@unique([contractId, code])
  @@index([contractId])
  @@map("obligations")
}

enum ActivityStatus {
  PENDIENTE
  EN_PROCESO
  EJECUTADA
  // Estados reservados para el flujo de revisión de Fase 2:
  SUBMITTED
  APPROVED
  REJECTED
  NEEDS_CORRECTION
}

enum Periodicity {
  SEMANAL
  QUINCENAL
  MENSUAL
  TRIMESTRAL
  PERSONALIZADO
}

model Activity {
  id               String         @id @default(uuid())
  obligationId     String
  obligation       Obligation     @relation(fields: [obligationId], references: [id])
  code             String
  name             String
  description      String?        @db.Text
  goal             String?
  unitOfMeasure    String
  plannedQuantity  Decimal        @default(0) @db.Decimal(18, 4)
  assignedValue    Decimal        @default(0) @db.Decimal(18, 2)
  weightPercentage Decimal        @default(0) @db.Decimal(5, 2)
  startDate        DateTime
  endDate          DateTime
  periodicity      Periodicity    @default(MENSUAL)
  responsibleId    String?
  responsible      User?          @relation("ActivityResponsible", fields: [responsibleId], references: [id])
  status           ActivityStatus @default(PENDIENTE)
  expectedResult   String?        @db.Text
  requiresEvidence Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  executionRecords ExecutionRecord[]
  evidences        Evidence[]

  @@unique([obligationId, code])
  @@index([obligationId])
  @@index([status])
  @@map("activities")
}

// ---------------------------------------------------------------------------
// PERIODOS Y REGISTROS DE EJECUCIÓN
// ---------------------------------------------------------------------------

model ExecutionPeriod {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id])
  label      String // ej. "Septiembre 2026"
  startDate  DateTime
  endDate    DateTime
  isClosed   Boolean  @default(false)
  createdAt  DateTime @default(now())

  executionRecords ExecutionRecord[]

  @@unique([contractId, startDate, endDate])
  @@index([contractId])
  @@map("execution_periods")
}

model ExecutionRecord {
  id                 String          @id @default(uuid())
  activityId         String
  activity           Activity        @relation(fields: [activityId], references: [id])
  periodId           String
  period             ExecutionPeriod @relation(fields: [periodId], references: [id])
  executedQuantity   Decimal         @db.Decimal(18, 4)
  executedValue      Decimal         @db.Decimal(18, 2)
  physicalPercentage Decimal         @db.Decimal(5, 2) // calculado: executedQuantity/plannedQuantity*100 del periodo
  result             String?         @db.Text
  observations       String?         @db.Text
  executionDate      DateTime
  registeredById     String
  registeredBy       User            @relation(fields: [registeredById], references: [id])
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  evidences Evidence[]

  @@index([activityId])
  @@index([periodId])
  @@map("execution_records")
}

// ---------------------------------------------------------------------------
// EVIDENCIAS Y DOCUMENTOS
// ---------------------------------------------------------------------------

enum EvidenceType {
  FOTOGRAFIA
  PDF
  WORD
  EXCEL
  ACTA
  CERTIFICADO
  VIDEO
  OTRO
}

enum EvidenceStatus {
  CARGADA
  // Reservado para Fase 2 (revisión de supervisor):
  APROBADA
  RECHAZADA
}

model Evidence {
  id                String           @id @default(uuid())
  contractId        String
  contract          Contract         @relation(fields: [contractId], references: [id])
  activityId        String?
  activity          Activity?        @relation(fields: [activityId], references: [id])
  executionRecordId String?
  executionRecord   ExecutionRecord? @relation(fields: [executionRecordId], references: [id])

  type        EvidenceType
  status      EvidenceStatus @default(CARGADA)
  description String?        @db.Text

  storageKey       String // ruta/clave en el storage (local o S3)
  originalFileName String
  mimeType         String
  sizeBytes        Int

  capturedAt DateTime? // fecha/hora de la fotografía si viene en el EXIF
  latitude   Decimal?  @db.Decimal(10, 7)
  longitude  Decimal?  @db.Decimal(10, 7)

  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())
  observations String?  @db.Text

  @@index([contractId])
  @@index([activityId])
  @@map("evidences")
}

model Document {
  id           String   @id @default(uuid())
  contractId   String
  contract     Contract @relation(fields: [contractId], references: [id])
  folder       String // Estudios previos, CDP, RP, Garantías, Actas, Informes, Facturas, Pagos, Modificaciones, Liquidación...
  name         String
  storageKey   String
  mimeType     String
  sizeBytes    Int
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  @@index([contractId])
  @@index([folder])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// PAGOS
// ---------------------------------------------------------------------------

enum PaymentStatus {
  PENDIENTE
  RADICADO
  EN_REVISION
  APROBADO
  PAGADO
  RECHAZADO
}

model Payment {
  id                 String        @id @default(uuid())
  contractId         String
  contract           Contract      @relation(fields: [contractId], references: [id])
  periodLabel        String
  invoiceNumber      String?
  accountNumber      String? // cuenta de cobro
  disbursementNumber String? // número de egreso (comprobante de egreso de tesorería)
  value              Decimal       @db.Decimal(18, 2)
  status             PaymentStatus @default(PENDIENTE)
  submittedDate      DateTime?
  paidDate           DateTime?
  observations       String?       @db.Text
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([contractId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// INDICADORES
// ---------------------------------------------------------------------------

enum IndicatorCategory {
  GESTION
  FINANCIERO
  TEMPORAL
  RESULTADOS
  PERSONALIZADO
}

model Indicator {
  id          String            @id @default(uuid())
  code        String            @unique
  name        String
  category    IndicatorCategory
  unit        String? // %, unidades, $, etc.
  formulaHint String? // descripción de cómo se calcula (documental, no ejecutable)
  createdAt   DateTime          @default(now())

  results IndicatorResult[]

  @@map("indicators")
}

model IndicatorResult {
  id           String    @id @default(uuid())
  indicatorId  String
  indicator    Indicator @relation(fields: [indicatorId], references: [id])
  contractId   String
  contract     Contract  @relation(fields: [contractId], references: [id])
  periodLabel  String
  value        Decimal   @db.Decimal(18, 4)
  calculatedAt DateTime  @default(now())

  @@index([contractId])
  @@index([indicatorId])
  @@map("indicator_results")
}

// ---------------------------------------------------------------------------
// ALERTAS
// ---------------------------------------------------------------------------

enum AlertType {
  CONTRATO_PROXIMO_A_VENCER
  ACTIVIDAD_ATRASADA
  EVIDENCIA_FALTANTE
  INFORME_PENDIENTE
  EJECUCION_INFERIOR_A_PROGRAMACION
  SALDO_PROXIMO_A_AGOTARSE
  MODIFICACION_CONTRACTUAL
  PERIODO_PENDIENTE
  DOCUMENTO_FALTANTE
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

model Alert {
  id         String        @id @default(uuid())
  contractId String
  contract   Contract      @relation(fields: [contractId], references: [id])
  type       AlertType
  severity   AlertSeverity
  message    String        @db.Text
  isResolved Boolean       @default(false)
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())

  @@index([contractId])
  @@index([isResolved])
  @@map("alerts")
}

// ---------------------------------------------------------------------------
// AUDITORÍA (solo inserción, sin endpoint de borrado)
// ---------------------------------------------------------------------------

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  action        String // CREATE_ACTIVITY, UPDATE_EXECUTION, UPLOAD_EVIDENCE, ...
  module        String
  entityId      String?
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([entityId])
  @@map("audit_logs")
}
